PORT=5000
NODE_ENV=production
DATABASE_URL=postgresql://db_user:db_password@127.0.0.1:5432/mindfullife
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_EXPIRES_IN=7d
CLIENT_URL=https://app.example.com
COOKIE_SAME_SITE=none
COOKIE_SECURE=true
TRUST_PROXY=1
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
REQUEST_TIMEOUT_MS=60000
KEEP_ALIVE_TIMEOUT_MS=5000
CRON_SECRET=replace_with_a_long_random_cron_secret
RUN_DAILY_REMINDER_JOB=false
VAPID_PUBLIC_KEY=your_local_or_production_vapid_public_key
VAPID_PRIVATE_KEY=your_local_or_production_vapid_private_key
VAPID_SUBJECT=mailto:notifications@example.com
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_AVATAR_FOLDER=mindfullife/avatars
AI_INSIGHTS_ENABLED=true
AI_PROVIDER=openai
AI_API_KEY=your_ai_provider_api_key
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_MIN_TEXT_LENGTH=120
PREMIUM_MONTHLY_CHECKOUT_URL=
PREMIUM_ANNUAL_CHECKOUT_URL=
BILLING_PORTAL_URL=
