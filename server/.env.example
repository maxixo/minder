PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/mindfullife
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
COOKIE_SAME_SITE=strict
COOKIE_SECURE=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
VAPID_PUBLIC_KEY=your_local_or_production_vapid_public_key
VAPID_PRIVATE_KEY=your_local_or_production_vapid_private_key
VAPID_SUBJECT=mailto:dev@example.com
